{
  "name": "reto-semanal",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma empresarial de gamificación para una campaña semanal.",
  "engines": {
    "node": "24.x",
    "npm": ">=11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "predev": "npm run check:env",
    "dev": "next dev",
    "prebuild": "npm run check:env",
    "build": "next build",
    "prestart": "npm run check:env",
    "start": "next start",
    "check:env": "node scripts/check-public-env.mjs",
    "avatars:generate": "node scripts/generate-avatars.mjs",
    "bootstrap:superadmin": "node scripts/bootstrap-superadmin.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "client-only": "0.0.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
